######################
# 1. DEPENDENCIES & BUILD OUTPUT (Required)
######################

# Node.js / React Frontend
node_modules/
/frontend/node_modules/
/frontend/dist/
.vite/
npm-debug.log*
yarn-error.log*

# Python / FastAPI Backend
# Virtual Environments
venv/
/backend/venv/
# Compiled/Cache files
__pycache__/
*.pyc
*.pyd
*.so
/backend/__pycache__/
/backend/*.pyc
.pytest_cache/

# Distribution/Builds
build/
dist/
*.egg-info/
.coverage

######################
# 2. LOCAL DATA & SECRETS (Crucial)
######################

# Database Files
tilt_data.db
finrisk.db
*.db
*.db-shm
*.db-wal

# Configuration & Secrets
.env
.env.local
.npmrc
*.log
.tilt_key
backend/.tilt_key

# Auto-generated JWT signing key.  Never commit this: it would let anyone who
# can read the repository mint valid session tokens for a deployment.
.finrisk_secret
backend/.finrisk_secret

# Machine-learning artifacts (fitted pipelines, regenerated by training)
backend/ml_artifacts/

# Coverage output
htmlcov/
frontend/coverage/

######################
# 3. OPERATING SYSTEM & IDEs
######################

# Linux
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code (or other IDEs)
.vscode/
.idea/
