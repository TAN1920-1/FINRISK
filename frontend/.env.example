# FinRisk AI frontend environment
#
# Copy this file to `.env` (or `.env.local`) and adjust as needed.  Every value
# here is optional: the app is designed to run with no configuration at all.
#
# Only variables prefixed with `VITE_` are exposed to the browser bundle, so
# never put a secret in this file.

# Absolute origin of the FastAPI backend, e.g. https://api.example.com.
# Leave empty to talk to the same origin, which is what the development proxy
# below provides and what a reverse-proxied deployment uses.
VITE_API_BASE_URL= https://finrisk-api-fq2i.onrender.com

# Development only: where the Vite dev server forwards `/api` requests.
# Ignored in a production build.  Defaults to http://127.0.0.1:8000.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
